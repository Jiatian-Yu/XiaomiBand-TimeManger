<template>
  <div class="page">
    <text class="title">{{title}}</text>
    <text class="subtitle">编辑任务信息</text>

    <div class="menu">
      <div class="menu-btn" @click="onEditTitle">
        <text class="menu-text">修改标题</text>
      </div>
      <div class="menu-btn menu-btn-danger" @click="onAskDelete">
        <text class="menu-text menu-text-danger">删除任务</text>
      </div>
      <div class="menu-btn" @click="onBack">
        <text class="menu-text">返回</text>
      </div>
    </div>

    <!-- 删除二次确认：弹窗内联在本页，避免为了一个弹窗再引一层组件事件 -->
    <div class="mask" if="{{confirmVisible}}">
      <div class="dialog">
        <text class="dialog-title">删除任务</text>
        <text class="dialog-text">确定要删除「{{title}}」吗？</text>
        <div class="dialog-btns">
          <div class="dlg-btn" @click="onCancelDelete">
            <text class="dlg-text">取消</text>
          </div>
          <div class="dlg-btn dlg-btn-danger" @click="onConfirmDelete">
            <text class="dlg-text">删除</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { useStore } from '../../utils/store'

export default {
  private: {
    taskId: null,
    title: '',
    confirmVisible: false
  },

  onInit() {
    this.store = useStore(this)
    // 草稿由主页长按时 beginEdit(id) 建好，这里只读
    const draft = this.store.getDraft()
    if (draft && draft.mode === 'edit') {
      this.taskId = draft.id
      this.title = draft.title
    }
  },

  // ---------- 修改标题 ----------
  // 草稿已在 edit 模式，直接进标题页，标题页确认后继续走目标时间页

  onEditTitle() {
    router.push({ uri: '/pages/task-title' })
  },

  // ---------- 删除 ----------

  onAskDelete() {
    this.confirmVisible = true
  },

  onCancelDelete() {
    this.confirmVisible = false
  },

  onConfirmDelete() {
    this.confirmVisible = false
    if (!this.taskId) {
      router.back()
      return
    }
    this.store.removeTask(this.taskId)
    this.store.discardDraft()
    vibrator.vibrate({ mode: 'short' })
    // 删完直接回主页，别再退回一个已经不存在的任务页
    try {
      router.clear()
      router.replace({ uri: '/pages/index' })
    } catch (e) {
      console.error('[task-edit] 清栈失败，退化为逐层返回', e)
      router.back()
    }
  },

  // ---------- 返回 ----------

  onBack() {
    // 没做任何修改就离开，丢掉草稿，避免污染下一次长按
    this.store.discardDraft()
    router.back()
  }
}
</script>

<style>
/* 安全区同主页（architecture.md §11.2） */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  background-color: #000000;
}

.title {
  margin-top: 44px;
  padding-left: 34px;
  padding-right: 34px;
  font-size: 22px;
  color: #ffffff;
  font-weight: bold;
}

.subtitle {
  margin-top: 6px;
  font-size: 15px;
  color: #48484a;
}

.menu {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.menu-btn {
  width: 158px;
  height: 46px;
  border-radius: 11px;
  background-color: #1c1c1e;
  justify-content: center;
  align-items: center;
  margin-bottom: 12px;
}

.menu-btn-danger {
  background-color: #2c1a1a;
}

.menu-text {
  font-size: 18px;
  color: #ffffff;
}

.menu-text-danger {
  color: #ff453a;
}

/* ---------- 确认弹窗 ---------- */

.mask {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.72);
  justify-content: center;
  align-items: center;
}

.dialog {
  width: 176px;
  border-radius: 14px;
  background-color: #1c1c1e;
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
  padding-bottom: 12px;
}

.dialog-title {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

.dialog-text {
  margin-top: 8px;
  padding-left: 14px;
  padding-right: 14px;
  font-size: 15px;
  color: #8e8e93;
  text-align: center;
}

.dialog-btns {
  width: 100%;
  flex-direction: row;
  margin-top: 16px;
  padding-left: 12px;
  padding-right: 12px;
}

.dlg-btn {
  flex: 1;
  height: 38px;
  border-radius: 9px;
  background-color: #2c2c2e;
  justify-content: center;
  align-items: center;
  margin-right: 8px;
}

.dlg-btn-danger {
  background-color: #ff453a;
  margin-right: 0px;
}

.dlg-text {
  font-size: 16px;
  color: #ffffff;
}
</style>
